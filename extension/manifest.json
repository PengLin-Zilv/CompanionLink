{
  "manifest_version": 3,
  "name": "CompanionLink",
  "version": "0.1.0",
  "description": "Export your companion chat history to CSV. Currently supports Replika.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "export.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://replika.com/*",
    "https://*.replika.com/*",
    "https://replika.ai/*",
    "https://*.replika.ai/*",
    "wss://ws.replika.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://replika.com/*",
        "https://*.replika.com/*",
        "https://replika.ai/*",
        "https://*.replika.ai/*"
      ],
      "js": ["contentScript.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageBridge.js"],
      "matches": [
        "https://replika.com/*",
        "https://*.replika.com/*",
        "https://replika.ai/*",
        "https://*.replika.ai/*"
      ]
    }
  ]
}
